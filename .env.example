NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback; leave empty for new Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback; leave empty for new Supabase projects.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_ENV=development

# Random server-only secret used to authenticate Vercel Cron requests. Never expose to the browser.
CRON_SECRET=
MUKURU_SEND_MONEY_URL=https://www.mukuru.com/send-money/

# AQE Manager Control: Google identity allowlist + signed password-gated manager session.
# Set both Google values in Vercel/Supabase deployment settings; never commit real values.
AQE_MANAGER_GOOGLE_EMAIL=admin@afiqueerecosystem.com
AQE_MANAGER_GOOGLE_SUB=
AQE_MANAGER_SESSION_SECRET=
# Optional developer-controlled manager password. Never commit the real value.
AQE_MANAGER_PASSWORD=
NEXT_PUBLIC_SITE_URL=https://afiqueerescortsecosystem.com
